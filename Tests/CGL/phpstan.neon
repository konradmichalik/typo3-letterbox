includes:
	- %rootDir%/../../konradmichalik/phpstan-typo3-preset/phpstan.neon.dist
	- phpstan-baseline.neon

parameters:
	level: 8

	scanDirectories:
		- ../../vendor
	paths:
		- ../../Classes
		- ../../Configuration
		- ../../Tests/Unit
		- ../../Tests/Functional

	excludePaths:
		- ../../Tests/Functional/Fixtures/Extensions/*/vendor (?)
		- ../../Tests/Functional/Fixtures/Extensions/*/ext_emconf.php

	type_coverage:
		constant: 0 # TODO: Set to 100, when PHP 8.3 is minimum requirement

	# Project-specific rule exceptions go below this line, each with a comment explaining why.

	ergebnis:
		noConstructorParameterWithDefaultValue:
			enabled: false # Optional constructor arguments of value objects (e.g. Address::$name) are part of the extension's public API.

	ignoreErrors:
		-
			# The frontend sub-request boots its own container, so the stack tests can only pass the environment through the process. tearDown() restores it.
			identifier: disallowed.function
			paths:
				- ../../Tests/Functional/External/ApiMiddlewareTest.php
				- ../../Tests/Functional/External/TesterInboxMiddlewareTest.php
		-
			# Only a real pseudo terminal proves the isatty() decision of letterbox:show, and proc_open() is the one way PHP opens one.
			identifier: disallowed.function
			path: ../../Tests/Functional/Command/ShowCommandTest.php
		-
			# sendmail passes its flags on the command line, which has no PSR-7 counterpart. TYPO3 binds the input before the command runs and loses the tokens after the first unknown flag, so the command reads the raw argv.
			identifier: disallowed.variable
			paths:
				- ../../Classes/Command/ReceiveCommand.php
				- ../../Tests/Functional/Command/ReceiveCommandTest.php
